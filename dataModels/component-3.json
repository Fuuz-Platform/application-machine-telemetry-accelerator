{
  "header": {
    "id": "asset",
    "name": "Asset",
    "description": "Represents a physical or logical piece of equipment, machine, or device within the manufacturing hierarchy. Assets are linked to Lines and Cells and include telemetry, maintenance schedules, and operational metadata. The model now supports linking to a **DeviceDriver** for integration and communication configuration.\n\n**Typical Use Cases**\n\n- Track machine details (manufacturer, model, serial number).\n- Associate assets with Lines and Cells for production visibility.\n- Manage preventive maintenance schedules (PM dates).\n- Capture telemetry and data points for performance monitoring.\n- Link to DeviceDriver for IoT and protocol-specific connectivity.",
    "dataModelKindId": "reference",
    "_customFields": {
      "_externalId": null
    }
  },
