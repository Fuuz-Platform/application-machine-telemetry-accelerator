  "header": {
    "id": "telemetryRaw",
    "name": "TelemetryRaw",
    "description": "Represents a raw telemetry record captured from a device or sensor before any processing, scaling, or historization. These records provide the original data values for diagnostics, validation, and troubleshooting.\n\n**Typical Use Cases**\n\n- Store unprocessed sensor readings for audit and verification.\n- Support advanced analytics by comparing raw and processed values.\n- Enable short-term retention for high-frequency data streams.",
    "dataModelKindId": "reference",
    "_customFields": {
      "_externalId": null
    }
  },
