  "header": {
    "id": "telemetryDaily",
    "name": "TelemetryDaily",
    "description": "Represents daily aggregated telemetry statistics for a DataPoint, including summary metrics like average, min, max, and standard deviation. Used for reporting, trend analysis, and performance dashboards.\n\n**Typical Use Cases**\n\n- Summarize raw telemetry into daily intervals for analytics.\n- Support shift-based reporting and KPI calculations.\n- Reduce storage overhead compared to raw telemetry while retaining essential insights.",
    "dataModelKindId": "reference",
    "_customFields": {
      "_externalId": null
    }
  },
