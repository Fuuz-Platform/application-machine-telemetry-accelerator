{
  "header": {
    "id": "telemetryHourly",
    "name": "TelemetryHourly",
    "description": "Represents hourly aggregated telemetry statistics for a DataPoint, including summary metrics like average, min, max, percentiles, and quality counts. Used for trend analysis, reporting, and performance dashboards.\n\n**Typical Use Cases**\n\n- Summarize raw telemetry into hourly intervals for analytics.\n- Support time-based reporting and KPI calculations.\n- Reduce storage overhead compared to raw telemetry while retaining essential insights.",
    "dataModelKindId": "reference",
    "_customFields": {
      "_externalId": null
    }
  },
