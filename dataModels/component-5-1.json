{
  "header": {
    "id": "dataPoint",
    "name": "DataPoint",
    "description": "Represents a single telemetry or process variable associated with an Asset. DataPoints define how values are collected, scaled, validated, and monitored for alarms and historical tracking.\n\n**Typical Use Cases**\n\n- Capture real-time sensor readings or machine parameters.\n- Apply scaling, limits, and deadband for accurate data acquisition.\n- Enable alarms and warnings for critical thresholds.\n- Historize data for trend analysis and reporting.\n- Associate DataPoints with Assets and Units for contextual meaning.",
    "dataModelKindId": "reference",
    "_customFields": {
      "_externalId": null
    }
  },
