        {
          "id": "553a54f9-e1c0-45e9-af98-5d12512542f4",
          "name": "Query DataPoint - for Anomaly only",
          "type": "query",
          "data": {
            "api": "application",
            "variablesTransform": "{\r\n    \"where\": {\r\n      \"id\": {\r\n        \"_eq\": $.value.after.dataPointId\r\n      }\r\n    }\r\n  }",
            "query": "query DataPoint($where: DataPointWhereInput, $orderBy: [DataPointOrderByInput!], $first: Int, $after: String, $dataPointId: String) {\n  dataPoint(where: $where, orderBy: $orderBy, first: $first, after: $after) {\n    edges {\n      node {\n        id\n        code\n        frequency\n        precision\n        deadband\n        lowerLimit\n        lowerWarning\n        scaleFactor\n        setPoint\n        tolerance\n        upperLimit\n        upperWarning\n        alarmEnabled\n        enabled\n        historize\n        isCritical\n        isOnChange\n        alarmPriority\n        category\n        dataType\n        description\n        displayName\n        name\n        asset {\n          id\n          code\n        }\n        unit {\n          id\n          code\n        }\n      }\n    }\n  }\n  \n  activeAlarms: alarm(\n    where: {\n      dataPointId: { _eq: $dataPointId }\n      clearedAt: { _isNull: true }\n    }\n    orderBy: [{ field: triggeredAt, direction: desc }]\n    first: 10\n  ) {\n    edges {\n      node {\n        id\n        code\n        alarmStateId\n        alarmState {\n          id\n          code\n        }\n        limitType\n        limitValue\n        \n        triggerValue\n        triggeredAt\n        acknowledgedAt\n      }\n    }\n  }\n}",
            "nextNodes": [
              "677675f3-d1e9-4565-b80e-52ddd4908da1"
            ]
          },
          "debug": {
            "breakpointEnabled": false,
            "publishSubscribeClient": false,
            "publishToMFGx": false
          },
