            "executionSucceeded": false,
            "executionFailed": true,
            "enableTraceLogging": false
          }
        },
        {
          "id": "c421bbb8-c0da-447e-9c36-cf882158abaa",
          "name": "Set Context",
          "type": "setContext",
          "data": {
            "transform": "{\r\n  \"rawData\": $\r\n}",
            "nextNodes": [
              "553a54f9-e1c0-45e9-af98-5d12512542f4"
            ]
          },
          "debug": {
            "breakpointEnabled": false,
            "publishSubscribeClient": false,
            "publishToMFGx": false
          },
