        {
          "id": "f4640832-9e9e-45f3-a728-af7639598ee5",
          "name": "Create Alarm",
          "type": "mutate",
          "data": {
            "api": "Application",
            "variablesTransform": "{\r\n  \"payload\": $.skip = true ? [] : [{\r\n    \"create\": {\r\n      \"dataPointId\": $.dataPointId,\r\n      \"limitType\": $.limitType,\r\n      \"limitValue\": $.limitValue,\r\n      \"triggerValue\": $.triggerValue,\r\n      \"deviation\": $.deviation,\r\n      \"triggeredAt\": $.triggeredAt,\r\n      \"alarmStateId\": $.alarmStateId,\r\n      \"notes\": $.notes,\r\n      \"customFields\": $._customFields,\r\n      \"telemetryRawData\": $state.context.rawData.value.after\r\n    }\r\n  }]\r\n}",
            "mutation": "mutation CreateAlarm($payload: [AlarmCreatePayloadInput!]!) {\n  createAlarm(payload: $payload) {\n    id\n    telemetryRawData\n  }\n}",
            "nextNodes": [
              "f74eef83-1406-459e-8a6a-340b62db80ba"
