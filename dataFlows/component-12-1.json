        {
          "id": "677675f3-d1e9-4565-b80e-52ddd4908da1",
          "name": "JavaScript",
          "type": "javascriptTransform",
          "data": {
            "nextNodes": [
              "f4640832-9e9e-45f3-a728-af7639598ee5"
            ],
            "transform": "// ============================================\r\n// Alarm Evaluation & Payload Generation\r\n// ============================================\r\n\r\n// Inputs\r\nconst telemetry = $state.context.rawData.value.after;  // Full telemetry record from subscription\r\nconst dpData = $.dataPoint.edges[0]?.node;\r\nconst activeAlarms = $.activeAlarms?.edges?.map(e => e.node) || [];\r\n\r\n// 1. Validate DataPoint exists\r\nif (!dpData) {\r\n  return {\r\n    skip: true,\r\n    reason: `DataPoint ${telemetry.dataPointId} not found in query results`\r\n  };\r\n}\r\n\r\n// 2. Check if alarmEnabled\r\nif (!dpData.alarmEnabled) {\r\n  return {\r\n    skip: true,\r\n    reason: `Alarms disabled for DataPoint ${dpData.code}`\r\n  };\r\n}\r\n\r\n// 3. Extract critical values\r\nconst value = telemetry.value;\r\nconst qualityCode = telemetry.qualityCode;\r\nconst deadband = dpData.deadband || 0;\r\n\r\n// 4. Check active alarms - if exists, evaluate deadband from previous trigger\r\nif (activeAlarms.length > 0) {\r\n  const latestAlarm = activeAlarms[0]; // Already sorted desc by triggeredAt\r\n  const previousValue = latestAlarm.triggerValue;\r\n  const valueDelta = Math.abs(value - previousValue);\r\n  \r\n  // If change is within deadband, skip creating new alarm\r\n  if (valueDelta <= deadband) {\r\n    return {\r\n      skip: true,\r\n      reason: `Value change (${valueDelta.toFixed(2)}) within deadband (${deadband}) of active alarm ${latestAlarm.code}`,\r\n      activeAlarmId: latestAlarm.id,\r\n      activeAlarmCode: latestAlarm.code,\r\n      previousValue: previousValue,\r\n      newValue: value,\r\n      delta: valueDelta\r\n    };\r\n  }\r\n}\r\n\r\n// 5. Determine alarm condition with deadband checking\r\nlet limitType = null;\r\nlet limitValue = null;\r\nlet deviation = null;\r\n\r\n// Quality is already BAD (16) or UNCERTAIN (64) per Accept node\r\n// Now determine WHY it's bad - which limit was violated?\r\n\r\n// Priority 1: Check critical limits (alarms)\r\nif (dpData.upperLimit != null && value > (dpData.upperLimit + deadband)) {\r\n  limitType = 'HighLimit';\r\n  limitValue = dpData.upperLimit;\r\n  deviation = value - dpData.upperLimit;\r\n}\r\nelse if (dpData.lowerLimit != null && value < (dpData.lowerLimit - deadband)) {\r\n  limitType = 'LowLimit';\r\n  limitValue = dpData.lowerLimit;\r\n  deviation = dpData.lowerLimit - value;\r\n}\r\n// Priority 2: Check warning limits\r\nelse if (dpData.upperWarning != null && value > (dpData.upperWarning + deadband)) {\r\n  limitType = 'HighWarning';\r\n  limitValue = dpData.upperWarning;\r\n  deviation = value - dpData.upperWarning;\r\n}\r\nelse if (dpData.lowerWarning != null && value < (dpData.lowerWarning - deadband)) {\r\n  limitType = 'LowWarning';\r\n  limitValue = dpData.lowerWarning;\r\n  deviation = dpData.lowerWarning - value;\r\n}\r\n// Priority 3: Check setPoint tolerance deviation\r\nelse if (dpData.setPoint != null && dpData.tolerance != null) {\r\n  const setPointDeviation = Math.abs(value - dpData.setPoint);\r\n  if (setPointDeviation > (dpData.tolerance + deadband)) {\r\n    limitType = 'Deviation';\r\n    limitValue = dpData.setPoint;\r\n    deviation = setPointDeviation;\r\n  }\r\n}\r\n\r\n// No limit violation found\r\nif (!limitType) {\r\n  return {\r\n    skip: true,\r\n    reason: `Value ${value} within all limits for ${dpData.code}`\r\n  };\r\n}\r\n\r\n// 6. Build Alarm creation payload\r\nreturn {\r\n  dataPointId: dpData.id,\r\n  limitType: limitType,\r\n  limitValue: limitValue,\r\n  triggerValue: value,\r\n  deviation: deviation,\r\n  triggeredAt: telemetry.recordedAt || new Date().toISOString(),\r\n  alarmStateId: 'ACTIVE',\r\n  notes: `${limitType} alarm triggered for ${dpData.displayName} (${dpData.code})`,\r\n  customFields: {\r\n    telemetrySnapshot: telemetry,\r\n    assetCode: dpData.asset?.code,\r\n    assetId: dpData.asset?.id,\r\n    unitCode: dpData.unit?.code,\r\n    dataPointCode: dpData.code,\r\n    dataPointName: dpData.displayName,\r\n    category: dpData.category,\r\n    qualityCode: qualityCode,\r\n    isCritical: dpData.isCritical,\r\n    alarmPriority: dpData.alarmPriority\r\n  }\r\n};"
          },
          "debug": {
            "breakpointEnabled": false,
            "publishSubscribeClient": false,
            "publishToMFGx": false
          },
          "logging": {
