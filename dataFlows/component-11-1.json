        {
          "id": "b2ea40bd-cbca-47c2-bd87-edf1f2edacea",
          "name": "Query Tenant Timezone Setting",
          "type": "query",
          "data": {
            "api": "application",
            "variablesTransform": "{\r\n  \"where\":{\r\n    \"id\":{\r\n       \"_eq\": \"Timezone\"\r\n    }\r\n  }\r\n}",
            "nextNodes": [
              "580d498c-c3e5-4c65-8e5c-cc67b88806cf"
            ],
            "query": "query Setting($where: SettingWhereInput, $orderBy: [SettingOrderByInput!], $first: Int, $after: String) {\r\n  setting(where: $where, orderBy: $orderBy, first: $first, after: $after) {\r\n    edges {\r\n      node {\r\n        defaultValue\r\n      }\r\n    }\r\n  }\r\n}"
          },
          "debug": {
            "breakpointEnabled": false,
            "publishSubscribeClient": false,
            "publishToMFGx": false
          },
          "logging": {
            "executionMetrics": false,
            "executionStarted": false,
            "executionSucceeded": false,
            "executionFailed": true,
            "enableTraceLogging": false
          }
        },
        {
          "id": "580d498c-c3e5-4c65-8e5c-cc67b88806cf",
          "name": "Get configuration details",
          "type": "transform",
          "data": {
            "transform": "(\r\n  /* Get tenant timezone from settings */\r\n  $timezone := $.setting.edges[0].node.defaultValue;\r\n  \r\n  /* Current time in tenant timezone */\r\n  $nowLocal := $moment().tz($timezone);\r\n  \r\n  /* Tomorrow's boundaries */\r\n  $tomorrowStart := $moment($nowLocal).add(1, 'day').startOf('day');\r\n  $tomorrowEnd := $moment($tomorrowStart).endOf('day');\r\n  \r\n  {\r\n    \"timezone\": $timezone,\r\n    \"nowLocal\": $nowLocal.format('YYYY-MM-DDTHH:mm:ss.SSSZ'),\r\n    \"tomorrowStart\": $tomorrowStart.format('YYYY-MM-DDTHH:mm:ss.SSSZ'),\r\n    \"tomorrowEnd\": $tomorrowEnd.format('YYYY-MM-DDTHH:mm:ss.SSSZ'),\r\n    \"tomorrowDate\": $tomorrowStart.format('YYYY-MM-DD'),\r\n    \"tomorrowDayOfWeek\": $tomorrowStart.format('dddd')\r\n  }\r\n)",
            "nextNodes": [
              "b1819b11-9489-4bdf-8399-a2965691264e"
            ]
          },
          "debug": {
            "breakpointEnabled": false,
            "publishSubscribeClient": false,
            "publishToMFGx": false
          },
          "logging": {
            "executionMetrics": false,
            "executionStarted": false,
            "executionSucceeded": false,
            "executionFailed": true,
            "enableTraceLogging": false
          }
        },
        {
          "id": "ab8e4095-73f6-429f-a47b-704d693945d1",
          "name": "Query Active Workcenters",
          "type": "query",
          "data": {
            "api": "application",
            "variablesTransform": "{}",
            "query": "query GetActiveWorkcenters {\r\n  workcenter(\r\n    where: {\r\n      isActive: { _eq: true }\r\n      scheduleGroupId: { _isNull: false }\r\n    }\r\n    first: 1000\r\n  ) {\r\n    edges {\r\n      node {\r\n        id\r\n        scheduleGroupId\r\n      }\r\n    }\r\n  }\r\n}",
            "nextNodes": [
              "c56a1d32-9f2a-4659-a3e7-4116420b0972"
            ]
          },
          "debug": {
            "breakpointEnabled": false,
            "publishSubscribeClient": false,
            "publishToMFGx": false
          },
          "logging": {
            "executionMetrics": false,
            "executionStarted": false,
            "executionSucceeded": false,
            "executionFailed": true,
            "enableTraceLogging": false
          }
        },
        {
          "id": "c56a1d32-9f2a-4659-a3e7-4116420b0972",
          "name": "JSONata",
          "type": "transform",
          "data": {
            "transform": "(\r\n  /* Extract config and workcenters */\r\n  $config := $state.context.config;\r\n  $workcenters := $.workcenter.edges.node;\r\n  \r\n  /* Group workcenters by scheduleGroupId */\r\n  $grouped := $workcenters{\r\n    scheduleGroupId: $[].id\r\n  };\r\n  \r\n  /* Process each scheduleGroupId and create batches of 25 */\r\n  $keys($grouped).(\r\n    $scheduleGroupId := $;\r\n    $allIds := $lookup($grouped, $);\r\n    $totalCount := $count($allIds);\r\n    \r\n    /* Create batches using array filtering */\r\n    [$map([0..$ceil($totalCount / 25) - 1], function($batchNum) {\r\n      {\r\n        \"workcenterIds\": $filter($allIds, function($v, $i) {\r\n          $i >= $batchNum * 25 and $i < ($batchNum + 1) * 25\r\n        }),\r\n        \"config\": $merge([$config, {\"scheduleGroupId\": $scheduleGroupId}])\r\n      }\r\n    })]\r\n  )[]\r\n)",
            "nextNodes": [
              "2c3ca170-44c1-4f9b-845f-b152b75f9fae"
            ]
          },
          "debug": {
            "breakpointEnabled": false,
            "publishSubscribeClient": false,
            "publishToMFGx": false
          },
          "logging": {
            "executionMetrics": false,
            "executionStarted": false,
